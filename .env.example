# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=authscope
POSTGRES_PASSWORD=authscope-dev
POSTGRES_DB=authscope

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3 / MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=authscope-dev
S3_SECRET_KEY=authscope-dev-secret
S3_BUCKET=authscope-artifacts
S3_REGION=us-east-1

# --- Scan engine ---
SCAN_TIMEOUT_SECONDS=45
LAZY_CAPTCHA_WAIT_SECONDS=5
SCAN_RESULT_CACHE_TTL_HOURS=6
BROWSER_CONTEXT_MAX_RAM_MB=150

# --- API ---
API_RATE_LIMIT_PER_MINUTE=60
DEV_API_KEY=dev-key

# --- Evidence storage policy ---
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_PRESIGN_EXPIRES_SECONDS=300

# --- Security (never disable SSRF guard in production) ---
SECURITY_DISABLE_SSRF_GUARD=false
